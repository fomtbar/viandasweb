# ============================================================
#  viandasWeb - variables de entorno
#
#  Copiar como .env  (deploy.sh / deploy.ps1 lo generan en el 1er uso).
#  NUNCA commitear el .env con credenciales reales.
#  El archivo debe quedar SIN BOM y con fines de linea LF.
# ============================================================

# ── Deploy ───────────────────────────────────────────────────
# Rama que hace pull deploy.sh / deploy.ps1
DEPLOY_BRANCH=main

# ── Base de datos ────────────────────────────────────────────
# DB_MODE: como accede la app a SQL Server
#   container -> SQL Server 2022 en Docker  (PC de desarrollo)
#   external  -> SQL Server de la compania en la red (PC servidor)
DB_MODE=container

# DB_HOST segun DB_MODE:
#   container -> mssql                 (nombre de servicio en la red Docker)
#   external  -> 10.20.30.40 | SRVSQL01 | host.docker.internal
# OJO: 'localhost' NO funciona desde dentro del contenedor.
DB_HOST=mssql
DB_PUERTO=1433
DB_NOMBRE=viandas

# Con DB_MODE=external la autenticacion integrada de Windows NO esta
# disponible desde un contenedor Linux: el SQL Server debe tener habilitado
# el modo mixto (SQL Authentication) y el protocolo TCP/IP en DB_PUERTO.
DB_USUARIO=sa

# Requisitos de SQL Server: 8+ chars, mayuscula, minuscula, numero y simbolo.
# NO usar  ;  {  }  $  "  '  #   -> rompen la connection string, la
# interpolacion de docker compose o el parseo del .env.
#   ';' y '{' '}'  -> cortan la connection string de SQL Server
#   '$'            -> docker compose lo interpola como variable
#   '#'            -> node --env-file lo toma como comentario y TRUNCA el valor,
#                     aunque no haya espacio delante. Sintoma: "Login failed
#                     for user 'sa'" solo desde la app, mientras prisma migrate
#                     (que usa DATABASE_URL entre comillas) funciona bien.
# Simbolos seguros:  _  -  !  %  ^  &  *  +  =
# El wizard genera una contrasena que ya los evita.
DB_PASSWORD=

# true con certificado autofirmado (el contenedor y casi todo SQL Server
# interno). false solo con certificado valido.
DB_TRUST_CERT=true

# Puerto del host donde se publica el SQL Server dockerizado (solo container).
# 14330 y no 1433 porque SGMIv2 ya publica su SQL Server en el 1433.
# Si esta PC no corre SGMIv2, 1433 sirve igual.
DB_PUERTO_HOST=14330

# ── Aplicacion ───────────────────────────────────────────────
# Puerto de la LAN: http://<ip-del-servidor>:3100
APP_PUERTO=3100
APP_NOMBRE=Sistema de Viandas

# Clave de firma de la cookie de sesion (HS256), 32+ bytes.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se cambia, TODAS las sesiones activas se invalidan.
AUTH_SECRET=

# COOKIE_SECURE: true SOLO si servis por HTTPS.
# En LAN por http://<ip>:3100 debe quedar en false: con true el navegador
# descarta la cookie y el login entra en bucle infinito sin ningun error.
COOKIE_SECURE=false

# Costo de bcrypt. 10 = ~60 ms por hash. 8 acelera la sincronizacion masiva
# de nomina; 12 endurece y hace el login mas lento.
BCRYPT_ROUNDS=10

# Zona horaria del contenedor. Afecta que dia es "hoy" en la pantalla de pedido.
TZ=America/Argentina/Buenos_Aires
